@page "/documents"
@attribute [Authorize]
@inject IDocumentService DocumentService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Documents</PageTitle>
<h1>Documents</h1>

<div class="mb-4">
    <InputFile OnChange="UploadFiles" multiple />
    <div class="row g-2 mt-2">
        <div class="col-md-4"><input class="form-control" @bind="title" placeholder="Title" /></div>
        <div class="col-md-4"><select class="form-select" @bind="category"><option value="">Category</option><option>Project Documents</option><option>Team Resources</option><option>Personal Files</option><option>Reports</option><option>Presentations</option><option>Other</option></select></div>
        <div class="col-md-4"><input class="form-control" @bind="search" @bind:event="oninput" placeholder="Search" /></div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(error)) { <div class="alert alert-danger">@error</div> }
@if (results.Count == 0) { <p>No documents found.</p> } else {
<table class="table"><thead><tr><th>Title</th><th>Category</th><th>File</th><th>Uploaded</th><th></th></tr></thead><tbody>
@foreach (var item in results) { <tr @key="item.DocumentId"><td>@item.Title</td><td>@item.Category</td><td>@item.OriginalFileName</td><td>@item.UploadedAt.ToLocalTime()</td><td><a href="documents/download/@item.DocumentId">Download</a></td></tr> }
</tbody></table>
}

@code {
    private List<DocumentSummary> results = new();
    private string title = string.Empty;
    private string category = string.Empty;
    private string search = string.Empty;
    private string? error;
    private int userId;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = int.Parse(state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0");
        await SearchDocuments();
    }

    private async Task SearchDocuments()
    {
        results = (await DocumentService.SearchAsync(userId, new DocumentQuery(Search: search, Category: string.IsNullOrWhiteSpace(category) ? null : category))).ToList();
    }

    private async Task UploadFiles(InputFileChangeEventArgs args)
    {
        error = null;
        if (string.IsNullOrWhiteSpace(title) || string.IsNullOrWhiteSpace(category)) { error = "Title and category are required."; return; }
        foreach (var file in args.GetMultipleFiles(20))
        {
            await using var stream = file.OpenReadStream(DocumentRules.MaxFileSize);
            var result = await DocumentService.UploadAsync(userId, new DocumentUploadRequest(title, category, file.Name, file.ContentType, file.Size, stream));
            if (!result.Success) error = $"{file.Name}: {result.Error}";
        }
        title = string.Empty;
        await SearchDocuments();
    }
}
